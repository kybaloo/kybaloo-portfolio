# URL canonique du site, sans slash final (ex. https://florentin-tchangai.dev).
# Utilisée pour construire les URLs absolues : `metadataBase`, les balises
# canoniques et hreflang, le sitemap et robots.txt (voir src/lib/site.ts).
#
# Optionnelle en local et sur les déploiements Vercel : en son absence, on
# retombe sur VERCEL_PROJECT_PRODUCTION_URL (fourni automatiquement par
# Vercel en production), puis sur http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity — identifiants du projet de contenu.
# Copier vers .env.local et remplir. .env.local n'est jamais commité.

# Publiques : exposées au navigateur, sans secret.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3000/studio

# Serveur uniquement. Le token donne accès aux brouillons : ne jamais le
# préfixer NEXT_PUBLIC_, ne jamais l'importer depuis un composant client.
SANITY_API_READ_TOKEN=
SANITY_REVALIDATE_SECRET=
